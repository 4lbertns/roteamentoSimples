const express = require('express');
const app = express();

const path = require('path');

app.get('/', (req, res) => res.sendFile(path.join(__dirname + './arq.js')));
app.get('/home', (req, res) => {
    res.sendFile(path.join(__dirname + './arq.js'));
});

app.get('/input1', (req, res) => {
    res.send(
        <form action='/home/input' method='GET'>
            <input name='nome' type='text' placeholder='Digite seu nome...' required></input>
            <input name='idade' type='number' placeholder='Digite sua idade...' required></input>
            <button type='submit'>Enviar</button>
        </form>)
})

app.get('/home/input', (req,res) => {
    let nome = req.query.nome;
    let idade = req.query.idade;
    res.send(`Entre no link: <a href='http://localhost:3000/home/form/${}/${}'>${nome}/${idade}</a>`)
});
app.get('/home/form/:nome/:idade', (req,res) => {
    let nome = req.params.nome;
    let idade = req.params.idade;
    
    res.send(`Seu nome é: ${nome} e sua idade é: ${idade}.`);
});

app.listen(3000, () => {
    console.log('na porta 3000.');
});

